# Copy to .env and fill in. Never commit .env.
# Local development: run `npm run db:start`, then copy API_URL and ANON_KEY from `supabase status`.

# Supabase (same names as the other demos)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI: AI_PROVIDER is "openai" or "fake" (no network calls). OPENAI_MODEL defaults to gpt-5.4-mini.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=

# Demo limits. Defaults: 30 AI actions per Sandbox (the database allows up to 50), 1000 a day across the
# demo (up to 10000, by UTC day), 5 Sandboxes per network in 24 hours (up to 50).
IP_HASH_SALT=
DEMO_AI_ACTIONS_PER_SANDBOX_PER_DAY=
DEMO_DAILY_AI_ACTION_CAP=
DEMO_SANDBOXES_PER_IP_PER_DAY=
